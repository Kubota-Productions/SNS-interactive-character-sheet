[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.4"
reloadable = false

[libraries]
linux.x86_64 = "res://addons/pdf_to_godot/native/linux-x86_64/libpdf_to_godot.so"
linux.arm64 = "res://addons/pdf_to_godot/native/linux-aarch64/libpdf_to_godot.so"
windows.x86_64 = "res://addons/pdf_to_godot/native/windows-x86_64/pdf_to_godot.dll"
macos.x86_64 = "res://addons/pdf_to_godot/native/macos-x86_64/libpdf_to_godot.dylib"
macos.arm64 = "res://addons/pdf_to_godot/native/macos-aarch64/libpdf_to_godot.dylib"
